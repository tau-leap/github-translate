{
  "manifest_version": 3,
  "name": "GitHub Translate",
  "version": "1.10.0",
  "description": "github.com の UI ラベルの右に、小さめの翻訳テキストを常時並記します。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub Translate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/", "https://github.com/*"],
      "js": [
        "src/config.js",
        "src/locales/ja/dictionary.js",
        "src/locales/ja/descriptions.js",
        "src/locale.js",
        "src/selectors.js",
        "src/annotate.js",
        "src/tooltip.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
